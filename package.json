{
  "name": "spellbook",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "classnames": "^2.2.6",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-helmet": "^6.1.0",
    "react-markdown": "^8.0.0",
    "react-redux": "^7.2.0",
    "react-router-dom": "^6.30.0",
    "react-window": "^1.8.5",
    "redux": "^4.0.5",
    "redux-persist": "^6.0.0",
    "rehype-raw": "^6.0.0",
    "rehype-sanitize": "^5.0.0",
    "remark-gfm": "^3.0.1",
    "reselect": "^4.0.0",
    "thenby": "^1.3.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^12.1.5",
    "@types/node": "^18.14.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^7.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^12.3.1",
    "prettier": "^2.0.5",
    "sass": "^1.49.0",
    "stylelint": "^14.3.0",
    "stylelint-config-recommended-scss": "^5.0.2",
    "stylelint-scss": "^4.1.0",
    "typescript": "^4.9.5",
    "vite": "^5.4.8",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext=js,jsx,ts,tsx src",
    "format:css": "stylelint \"src/**/*.scss\"",
    "deploy": "firebase deploy",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,json}": [
      "eslint --fix"
    ],
    "src/**/*.{scss}": [
      "stylelint --config=.stylelintrc --fix",
      "prettier --config .prettierrc --write"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "packageManager": "yarn@3.4.1",
  "resolutions": {
    "@babel/helper-compilation-targets": "^7.28.0",
    "@tootallnate/once": "^2.0.1",
    "brace-expansion": "^2.0.2",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.5",
    "diff": "^5.2.2",
    "flatted": "^3.4.0",
    "form-data": "^3.0.4",
    "immutable": "^4.3.8",
    "ip": "^2.0.1",
    "js-yaml": "^3.14.2",
    "lodash": "^4.18.0",
    "micromatch": "^4.0.8",
    "minimatch": "^5.1.7",
    "nanoid": "^3.3.17",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.23",
    "semver": "^6.3.1",
    "tar": "^6.2.1",
    "tough-cookie": "^4.1.3",
    "word-wrap": "^1.2.4",
    "ws": "^8.17.1",
    "yaml": "^1.10.3"
  }
}
